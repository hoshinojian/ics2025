# Sanity check
# wildcardcard是一个内置函数，作用是检查指定路径的文件 / 目录是否存在。 
# 如果存在，返回该文件的完整路径（如 ~/nemu/src/nemu-main.c）如果不存在，返回空
# 整个 ifeq 的判断逻辑：检查 $(NEMU_HOME)/src/nemu-main.c 文件是否不存在（因为右边是空字符串 ,)，即比较 wildcard 的返回值是否为空）。
ifeq ($(wildcard $(NEMU_HOME)/src/nemu-main.c),)
  # error也是内置函数， 终止程序
  $(error NEMU_HOME=$(NEMU_HOME) is not a NEMU repo)
endif

# Include variables and rules generated by menuconfig
# 普通 include 的 “容错版” 读取并执行指定文件中的 Makefile 规则，但如果指定的文件不存在、无法读取或有语法错误，
# Make 不会报错终止，只会输出一个警告（可选）并继续执行后续逻辑。
# 包含自动生成的依赖文件（如 .d 文件），适配第一次编译时依赖文件未生成的情况
-include $(NEMU_HOME)/include/config/auto.conf
-include $(NEMU_HOME)/include/config/auto.conf.cmd

# 一个名为 remove_quote 的自定义函数，等价于其他语言的函数声明
# $(patsubst 模式, 替换值, 目标字符串)：Makefile 内置的模式替换函数，核心作用是 “按模式匹配并替换字符串”：
  # $(patsubst  要匹配的模式 , 替换成什么 , 处理哪个字符串 )

# 第一个参数 "%"：匹配模式，% 是通配符，这里表示 “以双引号包裹的任意字符串”
# 第二个参数 %：替换后的值，这里表示 “去掉双引号后的原字符串”；
# 第三个参数代表argc[1]
# $(patsubst %.c, %.o, main.c foo.c test.c) 编程 main.o, ...

remove_quote = $(patsubst "%",%,$(1))

# Extract variabls from menuconfig
# 在auto.conf里面. 把guest_isa变成riscv32
# CONFIG_ENGINE="interpreter"
# CONFIG_ISA="riscv32"
GUEST_ISA ?= $(call remove_quote,$(CONFIG_ISA))
ENGINE ?= $(call remove_quote,$(CONFIG_ENGINE))
NAME    = $(GUEST_ISA)-nemu-$(ENGINE)

$(info GUEST_ISA = $(GUEST_ISA))
$(info ENGINE = $(ENGINE))
$(info NAME = $(NAME))
# 到这里, NAME变成了riscv32-nemu-interpreter

# Include all filelist.mk to merge file lists
# 调用系统 Shell 执行括号内的命令，并将命令的输出结果（stdout）作为函数返回值；
# find -L -name "filelist.mk"
#./src/engine/filelist.mk
# ./src/utils/filelist.mk
# ./src/isa/filelist.mk
# ./src/device/filelist.mk
# ./src/filelist.mk
FILELIST_MK = $(shell find -L ./src -name "filelist.mk")
$(info The value of TILELIST_MK is $(FILELIST_MK))
include $(FILELIST_MK)

# Filter out directories and files in blacklist to obtain the final set of source files
DIRS-BLACKLIST-y += $(DIRS-BLACKLIST)
SRCS-BLACKLIST-y += $(if $(DIRS-BLACKLIST-y), $(shell find -L $(DIRS-BLACKLIST-y) -name "*.c"),)
SRCS-BLACKLIST-y += $(SRCS-BLACKLIST)
SRCS-y += $(if $(DIRS-y), $(shell find -L $(DIRS-y) -name "*.c"),)
SRCS = $(filter-out $(SRCS-BLACKLIST-y),$(SRCS-y))

$(info =================================================)
$(info DIRS-BLACKLIST-y : $(DIRS-BLACKLIST-y))
$(info SRCS-BLACKLIST-y : $(SRCS-BLACKLIST-y))
$(info SRCS-y           : $(SRCS-y))
$(info FINAL SRCS       : $(SRCS))
$(info =================================================)

# VARS = DIRS-BLACKLIST-y SRCS-BLACKLIST-y SRCS-y SRCS
# debug:
# 	@$(foreach v, $(VARS), echo "$(v) = "; echo "$($(v))"; echo "-------------------";)


# Extract compiler and options from menuconfig
# CONFIG_CC="gcc"
ifneq ($(CONFIG_CC),)
CC = $(call remove_quote,$(CONFIG_CC))
endif
CFLAGS_BUILD += $(call remove_quote,$(CONFIG_CC_OPT))
# 根据 CONFIG_CC_LTO 变量是否有值，决定是否给 CFLAGS_BUILD 编译选项添加 -flto（链接时优化）参数。
# 如果 CONFIG_CC_LTO 有定义（非空），就追加 -flto；如果没定义（为空），则不追加任何内容。
CFLAGS_BUILD += $(if $(CONFIG_CC_LTO),-flto,)
# 如果开启了 DEBUG，就加入 -Og -ggdb3（方便 GDB 调试）。
CFLAGS_BUILD += $(if $(CONFIG_CC_DEBUG),-Og -ggdb3,)
# 如果开启了 ASAN（内存地址清理），就加入 -fsanitize=address。
CFLAGS_BUILD += $(if $(CONFIG_CC_ASAN),-fsanitize=address,)
$(info =================================================)
$(info CC : $(CC))
$(info CFLAGS_BUILD : $(CFLAGS_BUILD))
$(info =================================================)


# 情况 A（用户未配置条件）：CONFIG_ITRACE_COND 为空。Makefile 函数返回 true。
# 最终生成的编译参数为 -DITRACE_COND=true。这相当于在 C 代码中加入了 #define ITRACE_COND true。
CFLAGS_TRACE += -DITRACE_COND=$(if $(CONFIG_ITRACE_COND),$(call remove_quote,$(CONFIG_ITRACE_COND)),true)
# -D__GUEST_ISA__=$(GUEST_ISA) 等标志，将 Makefile 中的变量变成 C 语言里的宏，这样 NEMU 的 C 代码就能知道自己当前在模拟哪种架构了。

# -D 编译参数, 
CFLAGS  += $(CFLAGS_BUILD) $(CFLAGS_TRACE) -D__GUEST_ISA__=$(GUEST_ISA)
LDFLAGS += $(CFLAGS_BUILD)

# Include rules for menuconfig
include $(NEMU_HOME)/scripts/config.mk

# 这个时候把nemu当做一个客体程序

$(info =================================================)
# 如果 CONFIG_TARGET_AM 有值，打印 "Defined"，否则打印 "Not Defined"
$(info IT WILL BE INCLUDED: $(if $(CONFIG_TARGET_AM),am/makefile,native.mk))
$(info =================================================)
ifdef CONFIG_TARGET_AM
include $(AM_HOME)/Makefile
LINKAGE += $(ARCHIVES)
else
# Include rules to build NEMU
include $(NEMU_HOME)/scripts/native.mk
endif


